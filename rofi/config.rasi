configuration {
  modes: "window,drun,run,ssh";
  font: "JetBrainsMono Nerd Font 12";
  show-icons: true;
  terminal: "kitty";
  hover-select: true;
  fixed-num-lines: false;

  timeout {
      action: "kb-cancel";
      delay:  0;
  }

  filebrowser {
      directories-first: true;
      sorting-method:    "name";
  }
}

@theme "theme.rasi"
