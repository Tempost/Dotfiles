{
  "layer": "top",
  "modules-left": ["niri/workspaces", "systemd-failed-units"],
  "modules-center": ["niri/window"],
  "modules-right": [
    "custom/power-left-end",
    "group/power",
    "memory",
    "cpu",
    "temperature",
    "custom/tray-left-end",
    "group/sys-tray",
    "wireplumber",
    "custom/clock-icon",
    "clock",
    "custom/notifications",
  ],

  "group/cpu": {
    "orientation": "horizontal",
    "modules": ["cpu", "temperature"],
  },

  "temperature": {
    "interval": 1,
    "format": "  {temperatureC}°C",
    "tooltip": false,
    "hwmon-path": "/sys/devices/platform/coretemp.0/hwmon/hwmon5/temp1_input",
  },

  "cpu": {
    "format": "   {usage}%",
    "interval": 1,
  },

  "memory": {
    "interval": 1,
    "format": "   {percentage}%",
    "tooltip-format": "Phsyical: {used:0.1f}GiB/{total}GiB\nSwap:      {swapUsed:0.1f}GiB/{swapTotal}GiB",
  },

  "custom/notifications": {
    "tooltip": false,
    "format": " {icon} ",
    "format-icons": {
      "notification": "",
      "none": "",
      "dnd-notification": "",
      "dnd-none": "",
      "inhibited-notification": "",
      "inhibited-none": "",
      "dnd-inhibited-notification": "",
      "dnd-inhibited-none": "",
    },

    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
  },

  "custom/shutdown": {
    "format": " ",
    "tooltip": false,
    "on-click": "$HOME/Scripts/Power -s",
  },
  "niri/window": {
    "format": "{title}",
    "rewrite": {
      "(.*)Legcord(.*)": "Discord",
    },
  },

  "systemd-failed-units": {
    "hide-on-ok": true, // Do not hide if there is zero failed units.
    "format": "✗ {nr_failed}",
    "system": true, // Monitor failed systemwide units.
    "user": true, // Ignore failed user units.
  },

  "custom/reboot": {
    "format": "  ",
    "tooltip": false,
    "on-click": "$HOME/Scripts/Power -r",
  },

  "custom/logout": {
    "format": "  ",
    "tooltip": false,
    "on-click": "$HOME/Scripts/Power -l",
  },

  "custom/firmware": {
    "format": "  ",
    "tooltip": false,
    "on-click": "$HOME/Scripts/Power -f",
  },

  "custom/suspend": {
    "format": "  ",
    "tooltip": false,
    "on-click": "hyprlock & sleep 1; systemctl suspend",
  },

  "custom/divider": {
    "format": "|",
    "tooltip": false,
  },

  "custom/power-left-end": {
    "format": " ",
    "tooltip": false,
  },

  "group/power": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 600,
      "transition-left-to-right": false,
    },
    "modules": [
      "custom/shutdown",
      "custom/firmware",
      "custom/divider",
      "custom/suspend",
      "custom/divider",
      "custom/logout",
      "custom/divider",
      "custom/reboot",
      "custom/divider",
    ],
  },

  "tray": {
    "icon-size": 18,
    "spacing": 12,
  },

  "custom/tray-collapsed": {
    "format": "󰇙",
    "tooltip": false,
  },

  "custom/tray-left-end": {
    "format": " ",
    "tooltip": false,
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "show-special": true,
    "format-icons": {
      "active": "",
      "default": "",
      "special": "",
      "urgent": "",
    },
  },

  "group/sys-tray": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 600,
      "transition-left-to-right": false,
    },
    "modules": ["custom/tray-collapsed", "tray"],
  },

  "custom/clock-icon": {
    "format": " ",
    "tooltip": false,
  },

  "clock": {
    "format": "{:%I:%M:%S %p} ",
    "interval": 1,
    "tooltip": false,
  },

  "wireplumber": {
    "format": "{icon}    {volume}%",
    "format-muted": "",
    "format-icons": ["", ""],
    "scroll-step": 2,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": ".local/scripts/chsink",
  },
}
