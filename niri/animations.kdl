prefer-no-csd

// Animation settings.
// The wiki explains how to configure individual animations:
// https://github.com/YaLTeR/niri/wiki/Configuration:-Animations
animations {
  horizontal-view-movement {
    duration-ms 150
    curve "cubic-bezier" 1 0 0 1
  }

  workspace-switch {
    duration-ms 150
    curve "cubic-bezier" 1 0 0 1
  }

  overview-open-close {
    duration-ms 150
    curve "cubic-bezier" 1 0 0 1
  }

  window-open {
    duration-ms 150
    curve "cubic-bezier" 1 0 0 1
  }

  window-close {
    duration-ms 150
    curve "cubic-bezier" 1 0 0 1
  }
}
